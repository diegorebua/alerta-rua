rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidOccurrence(data) {
      let reqKeys = ['title', 'description', 'type', 'status', 'lat', 'lng', 'address', 'neighborhood', 'authorId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(reqKeys)
        && data.keys().size() == 11
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.description is string && data.description.size() <= 1000
        && data.type is string && data.type in ['pothole', 'light_out', 'trash', 'water_leak', 'other']
        && data.status is string && data.status in ['open', 'in_progress', 'resolved']
        && data.lat is number
        && data.lng is number
        && data.address is string && data.address.size() <= 200
        && data.neighborhood is string && data.neighborhood.size() <= 100
        && data.authorId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /occurrences/{occurrenceId} {
      allow read: if true; // Publicly readable feed
      
      allow create: if isSignedIn()
        && isValidId(occurrenceId)
        && isValidOccurrence(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().status == 'open';

      // Only the author can update, or we could just say no one updates. Let's say authors can update description/status.
      // But standard says status progress by prefeitura so standard user can't resolve it.
      // For now, let's keep it simple: authors can edit description or cancel (resolve?) it. Let's just allow read/create for now, and limited update.
      allow update: if isSignedIn()
        && isValidId(occurrenceId)
        && existing().authorId == request.auth.uid
        && existing().status == 'open'
        && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'updatedAt', 'status'])
        && incoming().description is string && incoming().description.size() <= 1000
        && incoming().status in ['open', 'resolved']
        && incoming().updatedAt == request.time;
    }
  }
}
